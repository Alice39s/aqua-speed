{
	"name": "aqua-speed",
	"version": "1.1.0",
	"description": "A modern network speed test CLI built with Bun and TypeScript.",
	"keywords": [
		"bun",
		"cdn",
		"cli",
		"network",
		"performance",
		"speedtest"
	],
	"license": "GPL-3.0-only",
	"author": "Alice39s",
	"type": "module",
	"module": "./src/cli.ts",
	"scripts": {
		"build": "bun build ./src/cli.ts --target=bun --outdir dist",
		"start": "bun run src/cli.ts",
		"dev": "bun --watch src/cli.ts",
		"test": "bun test",
		"lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives src tests",
		"format": "oxfmt --write .",
		"typecheck": "bun run lint",
		"format:check": "oxfmt --check .",
		"check": "bun run lint && bun run format:check && bun test && bun run build",
		"lint:fix": "oxlint --fix --type-aware --type-check src tests"
	},
	"dependencies": {
		"bogon": "1.3.0",
		"bufferutil": "4.1.0",
		"chalk": "6.0.1",
		"cli-progress": "3.12.0",
		"commander": "15.0.0",
		"ip-address": "10.7.5",
		"ora": "9.4.1",
		"ping": "1.0.0",
		"psl": "1.15.0",
		"table": "6.9.0",
		"undici": "8.12.3",
		"user-agents": "2.1.227",
		"ws": "8.22.0"
	},
	"devDependencies": {
		"@types/bogon": "1.0.2",
		"@types/bun": "1.4.4",
		"@types/cli-progress": "3.11.6",
		"@types/user-agents": "1.0.4",
		"@types/ws": "8.18.2",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"typescript": "7.0.2"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"packageManager": "bun@1.4.4",
	"patchedDependencies": {
		"psl@1.15.0": "patches/psl@1.15.0.patch"
	},
	"supportedArchitectures": {
		"os": [
			"win32",
			"darwin",
			"linux"
		],
		"cpu": [
			"x64",
			"arm64"
		]
	},
	"trustedDependencies": [
		"bufferutil"
	]
}
